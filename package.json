{
  "name": "sanskriti-ai-studio",
  "version": "1.0.0",
  "description": "Sanskriti AI Studio - Full-stack application with frontend and backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build:frontend",
    "preview": "npm run preview:frontend",
    "lint": "cd frontend && npm run lint",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && set PYTHONPATH=..&& uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "preview:frontend": "cd frontend && npm run preview"
  },
  "keywords": [
    "ai",
    "studio",
    "fullstack"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.24.6",
    "axios": "^1.18.1",
    "clsx": "^2.1.0",
    "postcss": "^8.4.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.1"
  }
}
